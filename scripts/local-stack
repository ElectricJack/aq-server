#!/usr/bin/env bash
# A complete local AQ stack built from sibling checkouts: server, PostgreSQL,
# aq-git, aq-graph, the current dashboard, the internal work host (routing) and
# a local worker that runs real tasks in sandboxes. docs/getting-started.md is
# the walk-through; this is the one tool it uses.
#
# Usage: scripts/local-stack COMMAND
#
#   doctor            check the prerequisites and the provider login (never prints it)
#   build [PART...]   build parts from the checkouts (default: all of them):
#                       server supervisor graph git dashboard worker template
#   up                start the stack (database, aq-graph, aq-git, server + dashboard)
#   seed              the scratch project: a local bare remote, the binding, one task
#   pins              pin the built worker programs and template image: writes the
#                     worker's native.json and the server's definitions from one
#                     run, restarts the server on them, saves the scratch binding
#                     and stores the Claude login (re-run after `build worker`
#                     or `build template`; this is "re-pin the driver")
#   check             refuse a mismatched worker/server pin pair
#   internal-work     start the internal work host and choose its levels
#   routing           save the default routing document when there is none, wait
#                     for its playbook to be authored, switch routing on
#   worker            enroll (once) and start the local worker service
#   task [ARGS]       file one small task and follow it (scripts/e2e-queued-task.py)
#   all               doctor, build, up, seed, pins, internal-work, worker, task, routing
#   reload PART       rebuild one part after a code change and restart what uses it
#   status            containers, workers and settings at a glance
#   worker-stop       stop the local worker service
#   down [-v]         stop the worker and the stack; -v also deletes its volumes
#
# One stack per Compose project. Everything is parameterised by environment:
#
#   AQ_LOCAL_PROJECT        Compose project and stack name (default aq-local)
#   AQ_LOCAL_HOME           the stack's state (default ~/.local/share/$AQ_LOCAL_PROJECT)
#   AQ_LOCAL_ADMIN_PORT     dashboard and owner API (default 18080)
#   AQ_LOCAL_WORKER_PORT    worker API (default 18081)
#   AQ_LOCAL_GRAPH_PORT     aq-graph (default 18741)
#   AQ_LOCAL_REGISTRY_PORT  loopback registry for the template image (default 5138)
#   AQ_LOCAL_{WORKER,DASHBOARD,GRAPH,GIT}_SRC   sibling checkouts (default ../aq-…)
#   AQ_LOCAL_CLAUDE_TOKEN_FILE   0600 file holding a Claude Code setup-token
#                           (default ~/.config/aq-secrets/claude-oauth-token)
#   AQ_LOCAL_SCRATCH_REPO   public repository the scratch project is cloned from
#   AQ_LOCAL_NODES          worker nodes to enroll (default 1); each node runs as
#                           many agents as the server Setting allows (default 2)
#   AQ_LOCAL_AGENTS         when set, the agents per node to set on the server
#   AQ_LOCAL_MACHINE_KEY    the machine's name on the Swarm page (default local-dev)
#   AQ_LOCAL_INTERNAL_LEVEL / AQ_LOCAL_AUTHORING_LEVEL
#                           intelligence levels for internal work in general and
#                           for playbook authoring (default standard-low / complex-high)
#   CARGO_BUILD_JOBS        passed to every cargo build
#
# The Claude token is never printed, logged or passed in argv: it is read from
# its file and piped on stdin.
set -euo pipefail
SRV=$(cd "$(dirname "$0")/.." && pwd)
STACK=${AQ_LOCAL_PROJECT:-aq-local}
BASE=${AQ_LOCAL_HOME:-$HOME/.local/share/$STACK}
ADMIN_PORT=${AQ_LOCAL_ADMIN_PORT:-18080} WORKER_PORT=${AQ_LOCAL_WORKER_PORT:-18081} GRAPH_PORT=${AQ_LOCAL_GRAPH_PORT:-18741}
REGISTRY=127.0.0.1:${AQ_LOCAL_REGISTRY_PORT:-5138}
WORKER_SRC=${AQ_LOCAL_WORKER_SRC:-$SRV/../aq-worker}
DASH_SRC=${AQ_LOCAL_DASHBOARD_SRC:-$SRV/../aq-dashboard}
GRAPH_SRC=${AQ_LOCAL_GRAPH_SRC:-$SRV/../aq-graph}
GIT_SRC=${AQ_LOCAL_GIT_SRC:-$SRV/../aq-git}
TOKEN_FILE=${AQ_LOCAL_CLAUDE_TOKEN_FILE:-$HOME/.config/aq-secrets/claude-oauth-token}
SCRATCH_REPO=${AQ_LOCAL_SCRATCH_REPO:-https://github.com/ElectricJack/aq-scratch.git}
NODES=${AQ_LOCAL_NODES:-1}
MACHINE_KEY=${AQ_LOCAL_MACHINE_KEY:-local-dev}
INTERNAL_LEVEL=${AQ_LOCAL_INTERNAL_LEVEL:-standard-low}
AUTHORING_LEVEL=${AQ_LOCAL_AUTHORING_LEVEL:-complex-high}
PROFILE=${STACK#aq-}
UNIT=aq-local-worker-$PROFILE.service
RUNTIME=$BASE/runtime
PROJECT=e0000000-0000-4000-8000-000000000002
LOCAL_REMOTE=/var/lib/aq/remotes/scratch.git
CREDENTIAL=owner-claude-subscription@2

export COMPOSE_PROJECT_NAME=$STACK
export AQ_DEV_ADMIN_PORT=$ADMIN_PORT AQ_DEV_WORKER_PORT=$WORKER_PORT AQ_DEV_GRAPH_PORT=$GRAPH_PORT
export AQ_DEV_SERVER_URL=http://127.0.0.1:$ADMIN_PORT AQ_DEV_WORKER_URL=http://127.0.0.1:$WORKER_PORT
export AQ_DEV_GRAPH_URL=http://127.0.0.1:$GRAPH_PORT
export AQ_DEV_STATE_DIR=$BASE/state AQ_SECRETS_DIR=$BASE/secrets
export AQ_SERVER_IMAGE=${AQ_SERVER_IMAGE:-agent-q-server:$PROFILE}
export AQ_DEV_GRAPH_IMAGE=${AQ_DEV_GRAPH_IMAGE:-aq-graph:$PROFILE}
export AQ_LOCAL_GIT_IMAGE=${AQ_LOCAL_GIT_IMAGE:-agent-q-git:$PROFILE}
export AQ_SUPERVISOR_HOST_IMAGE=${AQ_SUPERVISOR_HOST_IMAGE:-agent-q-supervisor-host:$PROFILE}
export AQ_DASHBOARD_BUNDLE=$DASH_SRC/dist
export AQ_DEV_COMPOSE_FILES=compose.dashboard.yaml:compose.local.yaml
# scripts/ms1-profiled.py reads these.
export AQ_MS1_HOME=$BASE AQ_MS1_WORKER_SRC=$WORKER_SRC AQ_MS1_D1=1
export AQ_DOCKER_LOCAL_SOCKET=${AQ_DOCKER_LOCAL_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/aq-sandbox/podman.sock}
# The dev vault takes the operator tables ([intelligence], [profiled_execution])
# from this file; `pins` writes it and replaces only that section of the vault.
INTELLIGENCE=$BASE/intelligence.toml
[ -f "$INTELLIGENCE" ] && export AQ_DEV_INTELLIGENCE_FILE=$INTELLIGENCE
export AQ_DEV_REPLACE_OPERATOR_SECTION=1
# The worker keeps its configuration and state inside the stack's home.
WORKER_ENV=(XDG_CONFIG_HOME="$BASE/worker/config" XDG_STATE_HOME="$BASE/worker/state")
WORKER_CONFIG=$BASE/worker/config/agent-q/service/$PROFILE

say() { printf '\n== %s  [%s]\n' "$*" "$(date -u +%H:%M:%SZ)"; }
die() { echo "local-stack: $*" >&2; exit 1; }
mkdir -p "$BASE" && chmod 700 "$BASE"

compose() {
  (cd "$SRV"
   eval "$(python3 scripts/dev-stack.py prepare | python3 -c 'import json,sys
for k,v in json.loads(sys.stdin.read()).items(): print(f"export {k}={v!r}")')"
   docker compose -f compose.yaml -f compose.dev.yaml -f compose.dashboard.yaml -f compose.local.yaml "$@")
}

# The owner API. api METHOD PATH [JSON-BODY]; prints the response body.
api() {
  local method=$1 path=$2
  if [ $# -ge 3 ]; then
    curl -fsS -X "$method" -H 'Content-Type: application/json' -H 'X-AQ-Request: 1' -d "$3" "$AQ_DEV_SERVER_URL$path"
  else
    curl -fsS -X "$method" -H 'X-AQ-Request: 1' "$AQ_DEV_SERVER_URL$path"
  fi
}
field() { python3 -c 'import json,sys
v = json.loads(sys.stdin.read(), strict=False)
for k in sys.argv[1].split("."):
    v = v.get(k) if isinstance(v, dict) else None
print("" if v is None else (json.dumps(v) if isinstance(v, (dict, list, bool)) else v))' "$1"; }

token_ok() {
  [ -f "$TOKEN_FILE" ] && [ ! -L "$TOKEN_FILE" ] && [ "$(stat -c %a "$TOKEN_FILE")" = 600 ] && [ -s "$TOKEN_FILE" ]
}

cmd_doctor() {
  local bad=0 v
  need() { command -v "$1" >/dev/null || { echo "missing: $1 ($2)"; bad=1; }; }
  need docker "Docker with Compose 2.24.4 or newer"; need python3 "3.12 or newer"; need cargo "rustup; the toolchain is pinned by rust-toolchain.toml"
  need node "24 or newer"; need pnpm "10"; need git ""; need curl ""; need tmux "the worker pins /usr/bin/tmux"; need systemctl "systemd user session"
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 12))' || { echo "python3 is older than 3.12"; bad=1; }
  v=$(node --version 2>/dev/null | sed 's/^v//; s/\..*//'); [ "${v:-0}" -ge 24 ] || { echo "node is older than 24"; bad=1; }
  docker compose version >/dev/null 2>&1 || { echo "docker compose is not available"; bad=1; }
  systemctl --user show-environment >/dev/null 2>&1 || { echo "systemd --user is not running (WSL2: [boot] systemd=true in /etc/wsl.conf)"; bad=1; }
  [ -x /usr/bin/tmux ] || { echo "no /usr/bin/tmux"; bad=1; }
  for d in "$WORKER_SRC" "$DASH_SRC" "$GRAPH_SRC" "$GIT_SRC"; do
    [ -d "$d/.git" ] || [ -f "$d/.git" ] || { echo "missing sibling checkout: $d"; bad=1; }
  done
  if token_ok; then echo "Claude token file: present, mode 600"
  else echo "Claude token file $TOKEN_FILE must be a non-empty regular file with mode 600 (create it with: claude setup-token)"; bad=1; fi
  for port in "$ADMIN_PORT" "$WORKER_PORT" "$GRAPH_PORT"; do
    if ! docker ps --filter "label=com.docker.compose.project=$STACK" -q | grep -q . && (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      echo "port $port is already in use; set AQ_LOCAL_ADMIN_PORT/AQ_LOCAL_WORKER_PORT/AQ_LOCAL_GRAPH_PORT"; bad=1
    fi
  done
  [ "$bad" = 0 ] || die "prerequisites are missing"
  echo "prerequisites: ok (stack $STACK, home $BASE, dashboard $AQ_DEV_SERVER_URL)"
}

build_server() {
  say "server image $AQ_SERVER_IMAGE from $(git -C "$SRV" rev-parse --short HEAD)"
  (cd "$SRV" && docker build --target server \
     --build-arg AQ_STATE_FORMAT="$(python3 scripts/migration_catalog.py)" \
     --build-arg AQ_SOURCE_REVISION="$(git rev-parse HEAD)" -t "$AQ_SERVER_IMAGE" .)
}
build_supervisor() {
  say "internal work host image $AQ_SUPERVISOR_HOST_IMAGE"
  (cd "$SRV" && docker build -f Dockerfile.supervisor-host --build-arg CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-4}" \
     -t "$AQ_SUPERVISOR_HOST_IMAGE" .)
}
build_graph() {
  say "aq-graph image $AQ_DEV_GRAPH_IMAGE from $(git -C "$GRAPH_SRC" rev-parse --short HEAD)"
  docker build -t "$AQ_DEV_GRAPH_IMAGE" "$GRAPH_SRC"
}
build_git() {
  say "aq-git image $AQ_LOCAL_GIT_IMAGE from $(git -C "$GIT_SRC" rev-parse --short HEAD)"
  docker image inspect "$AQ_SERVER_IMAGE" >/dev/null 2>&1 || build_server
  docker build -f "$SRV/scripts/Dockerfile.local-git" --build-arg BASE="$AQ_SERVER_IMAGE" \
    --build-arg CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-4}" -t "$AQ_LOCAL_GIT_IMAGE" "$GIT_SRC"
}
build_dashboard() {
  say "dashboard bundle from $(git -C "$DASH_SRC" rev-parse --short HEAD)"
  (cd "$DASH_SRC" && pnpm install --frozen-lockfile && pnpm build)
}
build_worker() {
  say "worker programs from $(git -C "$WORKER_SRC" rev-parse --short HEAD) into $RUNTIME"
  "$WORKER_SRC/packaging/local/build-runtime.sh" "$RUNTIME" --aq-git-checkout "$GIT_SRC"
}
build_template() {
  say "sandbox daemon and template image"
  "$WORKER_SRC/packaging/local/sandbox-daemon.sh" --cache "$BASE/cache"
  "$WORKER_SRC/packaging/local/build-template.py" --server-checkout "$SRV" --cache "$BASE/cache/template" \
    --registry "$REGISTRY" --registry-container "$STACK-template-registry" --output "$BASE/template.json"
}
cmd_build() {
  [ $# -gt 0 ] || set -- server supervisor graph git dashboard worker template
  for part in "$@"; do
    case $part in
      server|supervisor|graph|git|dashboard|worker|template) "build_$part" ;;
      *) die "unknown part $part (server supervisor graph git dashboard worker template)" ;;
    esac
  done
}

cmd_up() {
  say "start $STACK"
  [ -f "$AQ_DASHBOARD_BUNDLE/dashboard-manifest.json" ] || die "no dashboard bundle at $AQ_DASHBOARD_BUNDLE; run: $0 build dashboard"
  compose up -d --no-build --wait --wait-timeout 300
  api GET /healthz; echo
  echo "dashboard: $AQ_DEV_SERVER_URL/"
}

cmd_seed() {
  say "scratch project: local bare remote from $SCRATCH_REPO"
  # A writable bare remote inside the aq-git volume; aq-git publishes to it
  # with file transport, so no GitHub credential is involved.
  compose exec -T aq-git sh -ec "test -d $LOCAL_REMOTE || { mkdir -p ${LOCAL_REMOTE%/*}; \
    git clone --quiet --bare '$SCRATCH_REPO' $LOCAL_REMOTE; }; git --git-dir=$LOCAL_REMOTE log --oneline -1 main"
  (cd "$SRV" && DEV_SCRATCH_REPO_URL=$LOCAL_REMOTE DEV_SCRATCH_LOCAL_REMOTE=1 DEV_SCRATCH_BASE_BRANCH=main \
     DEV_SCRATCH_CREDENTIAL_REF=none python3 scripts/dev-stack.py seed) > "$BASE/seed-output.json"
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("project", d["project_id"], "task", d["task_id"])' "$BASE/seed-output.json"
  # The seed's placeholder task is not work for an agent.
  (cd "$SRV" && python3 scripts/ms1-task.py --retire e0000000-0000-4000-8000-000000000004 \
     "development seed placeholder, not work for an agent") >/dev/null 2>&1 || true
}

stored_versions() {
  compose exec -T postgres sh -ec "PGPASSWORD=\"\$(cat /run/secrets/postgres_password)\" psql -h 127.0.0.1 -U agent_q -d agent_q -tAc \"SELECT count(*) FROM credential_material_revisions WHERE credential_identity='$CREDENTIAL'\""
}

# The Claude login, in two places on the server's private volume: the
# configured base file (version 0), which must exist before the credential is
# registered, and the stored newest version (`aq-server import-login`).
stage_login() {
  token_ok || die "Claude token file $TOKEN_FILE must be a non-empty regular file with mode 600"
  local base=/var/lib/aq/credentials/owner-claude-subscription
  compose exec -T server test -s "$base" && return 0
  compose exec -T server sh -ec "umask 077; mkdir -p ${base%/*}; cat > $base.tmp; mv $base.tmp $base" < "$TOKEN_FILE"
  echo "staged the login's base file"
}
import_login() {
  local staged=/var/lib/aq/.local-login-import
  if [ "${1:-}" != --replace ] && [ "$(stored_versions)" != 0 ]; then echo "login: a stored version exists"; return 0; fi
  compose exec -T server sh -ec "umask 077; cat > $staged" < "$TOKEN_FILE"
  compose exec -T server sh -ec "trap 'rm -f $staged' EXIT
    export PGPASSWORD=\"\$(cat /run/secrets/postgres_password)\" DATABASE_URL=postgres://agent_q@postgres:5432/agent_q
    vault=/vault; if test -f /vault/settlement/config.toml; then vault=/vault/settlement; fi
    aq-server import-login --vault \"\$vault\" --credential $CREDENTIAL --revision \${AQ_MS1_CREDENTIAL_REVISION:-1} --source $staged" 2>&1 \
    | sed 's/\x1b\[[0-9;]*m//g' | grep -v 'INFO' | sed 's/^/import-login: /' || true
  echo "login: stored versions of $CREDENTIAL: $(stored_versions)"
}

cmd_pins() {
  say "pin the worker programs and the template image"
  [ -x "$RUNTIME/aq-sandbox-driver" ] || die "no worker programs in $RUNTIME; run: $0 build worker"
  [ -f "$BASE/template.json" ] || die "no template image; run: $0 build template"
  stage_login
  compose exec -T server sh -c 'mkdir -p /var/lib/aq/result-media && chmod 0700 /var/lib/aq/result-media'
  (cd "$SRV" && python3 scripts/ms1-profiled.py source >/dev/null && python3 scripts/ms1-profiled.py configure) > "$BASE/pins.json"
  export AQ_DEV_INTELLIGENCE_FILE=$INTELLIGENCE
  # Only the vault's operator section changes; dev-state-init copies it in.
  compose up -d --no-build --force-recreate --wait --wait-timeout 300 server
  (cd "$SRV" && python3 scripts/ms1-profiled.py apply)
  import_login
  if [ -d "$WORKER_CONFIG" ]; then
    install -m 0600 "$BASE/node/config/native.json" "$WORKER_CONFIG/native.json"
    echo "installed the new native.json for the enrolled worker"
    if systemctl --user is-active --quiet "$UNIT"; then systemctl --user restart "$UNIT"; echo "restarted $UNIT"; fi
  fi
  cmd_check
}

cmd_check() {
  (cd "$SRV" && AQ_LOCAL_WORKER_NATIVE=$([ -f "$WORKER_CONFIG/native.json" ] && echo "$WORKER_CONFIG/native.json") \
     python3 scripts/ms1-profiled.py check)
}

cmd_internal_work() {
  say "internal work host"
  token_ok || die "Claude token file $TOKEN_FILE must be a non-empty regular file with mode 600"
  local claude=${AQ_LOCAL_CLAUDE_BIN:-$BASE/cache/template/inputs/claude}
  [ -f "$claude" ] || die "no Claude Code executable at $claude (it is a public input of \`$0 build template\`; or set AQ_LOCAL_CLAUDE_BIN)"
  docker image inspect "$AQ_SUPERVISOR_HOST_IMAGE" >/dev/null 2>&1 || die "no image $AQ_SUPERVISOR_HOST_IMAGE; run: $0 build supervisor"
  # The host reads only root-owned 0600 files, so they are written as root
  # into its private volumes; every secret travels on stdin.
  fill() { # fill VOLUME FILE MODE < content
    docker run --rm -i --user 0:0 --network none --entrypoint sh -v "${STACK}_$1:/v" "$AQ_SERVER_IMAGE" \
      -ec "umask 077; cat > /v/.new; chmod $3 /v/.new; mv /v/.new /v/$2"
  }
  fill internal_native claude 0755 < "$claude"
  fill internal_claude_login claude-token 0600 < "$TOKEN_FILE"
  python3 - "$AQ_SECRETS_DIR/postgres_password" "$(sha256sum "$claude" | cut -d' ' -f1)" <<'EOF' | fill internal_config internal.json 0600
import json, sys, urllib.parse
password = open(sys.argv[1]).read().strip()
print(json.dumps({
    "database_url": f"postgres://agent_q:{urllib.parse.quote(password, safe='')}@postgres:5432/agent_q",
    "homes": "/internal/homes", "scratch": "/internal/scratch", "poll_ms": 200,
    "claude": {"native": "/opt/claude/claude", "native_digest": sys.argv[2],
               "secret_file": "/logins/claude/claude-token"}}, sort_keys=True))
EOF
  compose --profile internal-work up -d --no-build --force-recreate internal-work
  sleep 8
  [ "$(docker inspect "$STACK-internal-work-1" --format '{{.State.Status}} {{.RestartCount}}')" = "running 0" ] \
    || { docker logs --tail 20 "$STACK-internal-work-1" >&2; die "the internal work host did not stay up"; }
  # Which level internal work runs on is a Setting; a fresh server has none.
  local current revision body
  current=$(api GET /api/settings/internal-work)
  if [ -z "$(printf '%s' "$current" | field default_profile_id)" ]; then
    revision=$(printf '%s' "$current" | field revision)
    body=$(python3 -c 'import json,sys,uuid; print(json.dumps({"operation_id": str(uuid.uuid4()), "expected_revision": sys.argv[1],
      "default_profile_id": sys.argv[2], "overrides": {"playbook_compilation": sys.argv[3]}}))' "$revision" "$INTERNAL_LEVEL" "$AUTHORING_LEVEL")
    api PUT /api/settings/internal-work "$body" >/dev/null 2>&1 || api POST /api/settings/internal-work "$body" >/dev/null
  fi
  echo "internal work: $(api GET /api/settings/internal-work)"
}

cmd_routing() {
  say "routing"
  local doc state body deadline
  doc=$(api GET /api/settings/routing-document)
  if [ -z "$(printf '%s' "$doc" | field markdown)" ]; then
    body=$(python3 -c 'import json,sys,uuid; print(json.dumps({"markdown": open(sys.argv[1]).read(),
      "expected_revision": sys.argv[2], "operation_id": str(uuid.uuid4())}))' \
      "$SRV/crates/aq-profiles/defaults/routing.md" "$(printf '%s' "$doc" | field revision)")
    api PUT /api/settings/routing-document "$body" >/dev/null
    echo "saved the default routing document; the internal work host now authors its playbook (this takes a while: about 20 minutes on the live stack)"
  fi
  deadline=$(( $(date +%s) + ${AQ_LOCAL_ROUTING_TIMEOUT:-3600} ))
  while :; do
    state=$(api GET /api/settings/routing)
    [ -n "$(printf '%s' "$state" | field source.active.artifact)" ] && break
    [ "$(date +%s)" -lt "$deadline" ] || die "no routing playbook yet; see Settings → Intelligence → Routing, then run: $0 routing"
    printf 'waiting for the routing playbook: %s\n' "$(printf '%s' "$state" | python3 -c 'import json,sys
s = json.loads(sys.stdin.read(), strict=False).get("source") or {}
print({k: v for k, v in s.items() if k not in ("active", "document") and not isinstance(v, (dict, list))} or "authoring")')"
    sleep 30
  done
  if [ "$(printf '%s' "$state" | field enabled)" != true ]; then
    api PUT /api/settings/routing '{"enabled":true}' >/dev/null 2>&1 || api POST /api/settings/routing '{"enabled":true}' >/dev/null
  fi
  echo "routing: enabled=$(api GET /api/settings/routing | field enabled) artifact=$(api GET /api/settings/routing | field source.active.artifact)"
}

worker() { env "${WORKER_ENV[@]}" "$RUNTIME/aq-worker" "$@"; }

cmd_worker() {
  say "local worker ($NODES node(s), machine $MACHINE_KEY)"
  cmd_check
  "$WORKER_SRC/packaging/local/sandbox-daemon.sh" --cache "$BASE/cache" >/dev/null
  if [ ! -f "$WORKER_CONFIG/service.toml" ]; then
    local code
    code=$(api POST /api/enrollments '{}' | field code)
    # The single-use code is read from stdin, never argv.
    printf '%s\n' "$code" | worker service enroll --profile "$PROFILE" --server "$AQ_DEV_WORKER_URL" \
      --nodes "$NODES" --machine-key "$MACHINE_KEY" --native-template "$BASE/node/config/native.json" \
      --aq-git "$RUNTIME/aq-git" --git-executable "$(command -v git)"
    unset code
  else
    install -m 0600 "$BASE/node/config/native.json" "$WORKER_CONFIG/native.json"
  fi
  local unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  mkdir -p "$unit_dir"
  cat > "$unit_dir/$UNIT" <<EOF
# Written by aq-server scripts/local-stack for the stack $STACK. The worker's
# configuration and state live under $BASE/worker.
[Unit]
Description=AQ local worker ($STACK)
Requires=aq-sandbox-podman.service
After=aq-sandbox-podman.service
StartLimitIntervalSec=0

[Service]
Type=exec
Environment=XDG_CONFIG_HOME=$BASE/worker/config XDG_STATE_HOME=$BASE/worker/state RUST_LOG=info
ExecStart=$RUNTIME/aq-worker run --service-config $WORKER_CONFIG/service.toml
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=150

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" >/dev/null 2>&1
  systemctl --user restart "$UNIT"
  local i online=
  for i in $(seq 1 30); do
    online=$(api GET /api/v1/swarm | python3 -c 'import json,sys
for m in json.loads(sys.stdin.read(), strict=False)["data"]["machines"]:
    if m["id"] == sys.argv[1]: print(m["state"])' "$MACHINE_KEY")
    [ "$online" = online ] && break; sleep 2
  done
  if [ -n "${AQ_LOCAL_AGENTS:-}" ]; then set_agents "$AQ_LOCAL_AGENTS"; fi
  worker service status --profile "$PROFILE" || true
  echo "machine $MACHINE_KEY: ${online:-not seen yet} (log: journalctl --user -u $UNIT -f)"
}

# Agents per node are a server Setting (docs/operations/multi-agent-nodes.md).
set_agents() {
  api GET /api/worker-management | python3 -c 'import json,sys,uuid
d = json.loads(sys.stdin.read(), strict=False)
def walk(o):
    if isinstance(o, dict):
        if "max_agents" in o and "revision" in o and (o.get("node_id") or o.get("id")):
            yield o
        for v in o.values(): yield from walk(v)
    elif isinstance(o, list):
        for v in o: yield from walk(v)
for node in walk(d.get("machines", d)):
    if node.get("machine_key", sys.argv[2]) != sys.argv[2] and node.get("machine") not in (None, sys.argv[2]): continue
    print(node.get("node_id") or node["id"], json.dumps({"operation_id": str(uuid.uuid4()),
          "expected_revision": node["revision"], "label": node.get("label"), "max_agents": int(sys.argv[1])}))' "$1" "$MACHINE_KEY" \
  | while read -r node body; do api PUT "/api/worker-management/node/$node" "$body" >/dev/null && echo "node $node: $1 agents"; done
}

cmd_worker_stop() { systemctl --user stop "$UNIT" 2>/dev/null || true; }

cmd_task() {
  (cd "$SRV" && python3 scripts/e2e-queued-task.py --api "$AQ_DEV_SERVER_URL" --machine "$MACHINE_KEY" "$@")
}

cmd_status() {
  docker ps -a --filter "label=com.docker.compose.project=$STACK" --format '{{.Names}}\t{{.Status}}'
  api GET /api/v1/swarm | python3 -c 'import json,sys
d = json.loads(sys.stdin.read(), strict=False)["data"]
for m in d["machines"]:
    print("machine", m["id"], m["state"], "nodes", len(m.get("nodes", [])))'
  echo "routing: enabled=$(api GET /api/settings/routing | field enabled) artifact=$(api GET /api/settings/routing | field source.active.artifact)"
  echo "internal work level: $(api GET /api/settings/internal-work | field default_profile_id)"
  echo "worker unit $UNIT: $(systemctl --user is-active "$UNIT" 2>/dev/null || true)"
  echo "dashboard: $AQ_DEV_SERVER_URL/"
}

cmd_reload() {
  case ${1:-} in
    server) build_server; compose up -d --no-build --force-recreate --wait --wait-timeout 300 server ;;
    dashboard) build_dashboard; compose up -d --no-build --force-recreate --wait --wait-timeout 300 server ;;
    graph) build_graph; compose up -d --no-build --force-recreate --wait --wait-timeout 300 aq-graph ;;
    git) build_git; compose up -d --no-build --force-recreate --wait --wait-timeout 300 aq-git
         build_worker; cmd_pins ;;
    supervisor) build_supervisor; compose --profile internal-work up -d --no-build --force-recreate internal-work ;;
    # The sandbox driver is pinned by digest on both sides: stop the worker,
    # replace the programs, re-pin (which reinstalls native.json), start it.
    worker) cmd_worker_stop; build_worker; cmd_pins; systemctl --user start "$UNIT" ;;
    template) cmd_worker_stop; build_template; cmd_pins; systemctl --user start "$UNIT" ;;
    *) die "reload: server | dashboard | graph | git | supervisor | worker | template" ;;
  esac
}

cmd_down() {
  cmd_worker_stop
  if [ "${1:-}" = -v ]; then
    systemctl --user disable "$UNIT" >/dev/null 2>&1 || true
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"; systemctl --user daemon-reload
    compose --profile internal-work down -v
    docker rm -f "$STACK-template-registry" >/dev/null 2>&1 || true
    echo "volumes deleted. The stack's home $BASE (state, secrets, worker enrollment) is kept: delete it for a clean start."
  else
    compose --profile internal-work down
  fi
}

case ${1:-} in
  doctor) cmd_doctor ;;
  build) shift; cmd_build "$@" ;;
  up) cmd_up ;;
  seed) cmd_seed ;;
  pins) cmd_pins ;;
  check) cmd_check ;;
  internal-work) cmd_internal_work ;;
  routing) cmd_routing ;;
  worker) cmd_worker ;;
  worker-stop) cmd_worker_stop ;;
  task) shift; cmd_task "$@" ;;
  status) cmd_status ;;
  reload) cmd_reload "${2:-}" ;;
  down) cmd_down "${2:-}" ;;
  all) cmd_doctor; cmd_build; cmd_up; cmd_seed; cmd_pins; cmd_internal_work; cmd_worker; cmd_task --note first; cmd_routing ;;
  *) sed -n '2,52p' "$0"; exit 2 ;;
esac
