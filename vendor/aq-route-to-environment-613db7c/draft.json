{
  "purpose": "Choose the environment a task runs in",
  "entries": {
    "main": {
      "input": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "max_length": 4096
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "id",
              "revision"
            ]
          }
        },
        "required": [
          "task"
        ]
      },
      "outcomes": {
        "routed": {
          "type": "null"
        },
        "unroutable": {
          "type": "null"
        },
        "skipped": {
          "type": "null"
        },
        "refused": {
          "type": "null"
        },
        "failed": {
          "type": "null"
        }
      },
      "start": "read"
    }
  },
  "triggers": [
    {
      "id": "task-ready",
      "event": "aq.work.route_needed",
      "entry": "main",
      "input": {
        "op": "object",
        "fields": {
          "task": {
            "op": "ref",
            "root": "event",
            "path": [
              "subject"
            ]
          }
        }
      }
    }
  ],
  "steps": {
    "read": {
      "op": {
        "kind": "invoke",
        "command": "work.read",
        "bind": "task",
        "retry": null,
        "input": {
          "op": "object",
          "fields": {
            "subject": {
              "op": "ref",
              "root": "input",
              "path": [
                "task"
              ]
            }
          }
        }
      },
      "edges": {
        "observed": "owned",
        "refused": "skipped"
      },
      "on_error": "failed"
    },
    "owned": {
      "op": {
        "kind": "decide",
        "predicate": {
          "op": "eq",
          "left": {
            "op": "ref",
            "root": "task",
            "path": [
              "facts",
              "route"
            ]
          },
          "right": {
            "op": "literal",
            "value": "owner"
          }
        }
      },
      "edges": {
        "true": "skipped",
        "false": "tried",
        "unknown": "failed"
      },
      "on_error": null
    },
    "tried": {
      "op": {
        "kind": "decide",
        "predicate": {
          "op": "lt",
          "left": {
            "op": "literal",
            "value": 0
          },
          "right": {
            "op": "ref",
            "root": "task",
            "path": [
              "facts",
              "ended_attempts"
            ]
          }
        }
      },
      "edges": {
        "true": "keep",
        "false": "default_each",
        "unknown": "failed"
      },
      "on_error": null
    },
    "keep": {
      "op": {
        "kind": "invoke",
        "command": "work.route",
        "bind": "keep_route",
        "retry": null,
        "input": {
          "op": "object",
          "fields": {
            "subject": {
              "op": "ref",
