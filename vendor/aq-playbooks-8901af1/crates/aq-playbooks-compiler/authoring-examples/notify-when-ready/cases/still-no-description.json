{
  "name": "still-no-description",
  "situation": "A task a playbook filed still has no description after ten minutes",
  "start": {
    "kind": "event",
    "event": "aq.work.changed",
    "payload": {
      "outcome": "ensured",
      "reference": "task-40@2",
      "subject": {
        "id": "task-40",
        "revision": 2
      }
    },
    "correlation": {
      "operation": "work-op-1"
    }
  },
  "returns": {
    "work.read": [
      {
        "outcome": "observed",
        "output": {
          "reference": "task-40@2",
          "subject": {
            "id": "task-40",
            "revision": 2
          },
          "facts": {
            "kind": "",
            "title": "Add a dark theme",
            "description": "",
            "origin": "owner",
            "level_hint": "",
            "charged_failures": 0,
            "ended_attempts": 0,
            "route": "none"
          }
        }
      }
    ],
    "message.send": [
      {
        "outcome": "queued",
        "output": {
          "reference": "message-1",
          "subject": {
            "id": "task-40",
            "revision": 2
          }
        }
      }
    ]
  },
  "expect": {
    "outcome": "reminded",
    "calls": [
      {
        "command": "work.read",
        "input": {
          "subject": {
            "id": "task-40",
            "revision": 2
          }
        }
      },
      {
        "command": "message.send",
        "input": {
          "identity": "task-40@2",
          "recipient": "user:owner-1",
          "visibility": "project",
          "body": "This task has had no description for ten minutes. Please add one, so that it can be worked on."
        }
      }
    ]
  }
}
