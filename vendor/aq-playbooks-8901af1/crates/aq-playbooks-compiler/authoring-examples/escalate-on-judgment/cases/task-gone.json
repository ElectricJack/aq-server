{
  "name": "task-gone",
  "situation": "The task no longer exists when it is read",
  "start": {
    "kind": "event",
    "event": "aq.work.route_needed",
    "payload": {
      "subject": {
        "id": "task-32",
        "revision": 5
      }
    }
  },
  "returns": {
    "work.read": [
      {
        "outcome": "refused",
        "output": {
          "reference": "task-32@5",
          "subject": {
            "id": "task-32",
            "revision": 5
          },
          "reason": "unknown_task"
        }
      }
    ]
  },
  "expect": {
    "outcome": "skipped",
    "calls": [
      {
        "command": "work.read",
        "input": {
          "subject": {
            "id": "task-32",
            "revision": 5
          }
        }
      }
    ]
  }
}
