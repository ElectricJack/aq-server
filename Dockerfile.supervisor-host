# F1a standalone host. E1c production orchestration and provider qualification
# are separate gates; supply the exact native executable as a read-only mount.
FROM rust:1.96.1-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY vendor ./vendor
COPY protocol ./protocol
RUN echo 'ab37cb192870f07290b4aff887b57b73783931ba5dfc248184da483c99036bdb  vendor/aq-session-host-0.1.7-source.tar.gz' | sha256sum -c -
RUN mkdir /pinned && tar -xzf vendor/aq-session-host-0.1.7-source.tar.gz -C /pinned --strip-components=1 \
    && diff -r /pinned/crates/aq-session-host/src vendor/aq-session-host-0.1.7/src \
    && diff -r /pinned/crates/aq-codex-mapper/src vendor/aq-codex-mapper-0.1.1/src \
    && diff -r /pinned/crates/aq-responses-transport/src vendor/aq-responses-transport-0.1.0/src
# Two jobs suit a small CI runner; a developer machine passes more.
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
# The target cache is shared by every build of this Dockerfile on the host
# (other branches and worktrees). Touch the path-crate sources in the same
# step as the build so cargo's mtime check never reuses another tree's build.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=aq-supervisor-host-release,sharing=locked,target=/build/target \
    find crates vendor protocol -type f -exec touch {} + \
    && cargo build --locked --release -p aq-supervisor-host --bins \
    && cargo build --locked --release --manifest-path vendor/aq-playbooks-5b86e0f/Cargo.toml \
        --target-dir target/aq-playbooks -p aq-playbooks-cli --bin aq-playbooks \
    && mkdir /out && cp target/release/aq-supervisor-host target/release/aq-session-host \
        target/aq-playbooks/release/aq-playbooks /out/
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tmux libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 native && useradd --uid 10001 --gid native --no-create-home native \
    && install -d -m 700 /host \
    && install -d -m 711 /native-homes \
    && install -d -m 700 -o 10001 -g 10001 /workspace
COPY --from=build /out/aq-supervisor-host /usr/local/bin/aq-supervisor-host
COPY --from=build /out/aq-session-host /usr/local/bin/aq-session-host
# The engine's authoring tools, off PATH: an authoring agent reaches them
# only through the shim the host writes into its run (spec 0013 §4.2).
COPY --from=build /out/aq-playbooks /usr/local/libexec/aq-playbooks
# Root owns transport/credential; only the native child runs as 10001.
# Run in a private PID namespace without a Docker socket or privileged mode.
USER 0:0
ENTRYPOINT ["/usr/local/bin/aq-supervisor-host"]
CMD ["run", "/config/supervisor.json"]
