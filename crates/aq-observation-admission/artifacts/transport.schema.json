{
  "batch_reply": {
    "$defs": {
      "Digest": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "ReceiptDisposition": {
        "enum": [
          "observation_recorded",
          "suspension_recorded",
          "checkpoint_recorded",
          "parking_recorded",
          "continuation_received",
          "bootstrap_acknowledgment_recorded"
        ],
        "type": "string"
      },
      "RefusalReason": {
        "description": "Why the server refused every record of one source in a batch.",
        "oneOf": [
          {
            "const": "unknown_source",
            "description": "The node has no such enrolled source.",
            "type": "string"
          },
          {
            "const": "binding",
            "description": "The record's attempt binding is not the enrolled one, or the attempt\nmay no longer be observed.",
            "type": "string"
          },
          {
            "const": "provenance",
            "description": "The record's session key is not the enrolled one.",
            "type": "string"
          },
          {
            "const": "parser",
            "description": "The parser is not in the source's catalog entry.",
            "type": "string"
          },
          {
            "const": "control_shape",
            "description": "A control parser on a record that is not a gap.",
            "type": "string"
          },
          {
            "const": "refused",
            "description": "An earlier batch already refused this source.",
            "type": "string"
          }
        ]
      },
      "RefusedSource": {
        "additionalProperties": false,
        "properties": {
          "generation": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "$ref": "#/$defs/RefusalReason"
          },
          "source_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "generation",
          "reason"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The batch route's reply: the unchanged CON03 receipt, plus the sources\nwhose records in this batch were refused. The receipt still covers the\nwhole batch, so one refused source never holds back the node sequence; the\nworker stops collecting each listed source. Without refusals the bytes are\nexactly the receipt's.",
    "properties": {
      "body_digest": {
        "$ref": "#/$defs/Digest"
      },
      "disposition": {
        "$ref": "#/$defs/ReceiptDisposition"
      },
      "message_id": {
        "format": "uuid",
        "type": "string"
      },
      "refused_sources": {
        "items": {
          "$ref": "#/$defs/RefusedSource"
        },
        "type": "array"
      },
      "schema_version": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "through_sequence": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "schema_version",
      "message_id",
      "body_digest",
      "disposition"
    ],
    "title": "BatchReply",
    "type": "object"
  },
  "reply": {
    "$defs": {
      "Digest": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "Marker": {
        "additionalProperties": false,
        "description": "Written durably into the new store before activation. Initial boot never changes.",
        "properties": {
          "initial_boot_id": {
            "format": "uuid",
            "type": "string"
          },
          "node_id": {
            "format": "uuid",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "type": "string"
          },
          "prepare_digest": {
            "$ref": "#/$defs/Digest"
          },
          "prepare_operation_id": {
            "format": "uuid",
            "type": "string"
          },
          "store_id": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "node_id",
          "store_id",
          "owner_id",
          "initial_boot_id",
          "prepare_operation_id",
          "prepare_digest"
        ],
        "type": "object"
      },
      "Owner": {
        "additionalProperties": false,
        "properties": {
          "boot_transitions": {
            "description": "Counts every boot advance. A node may restart without limit.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "current_boot_id": {
            "format": "uuid",
            "type": "string"
          },
          "marker": {
            "$ref": "#/$defs/Marker"
          },
          "phase": {
            "$ref": "#/$defs/Phase"
          },
          "revision": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "marker",
          "phase",
          "current_boot_id",
          "revision",
          "boot_transitions"
        ],
        "type": "object"
      },
      "Phase": {
        "enum": [
          "prepared",
          "active"
        ],
        "type": "string"
      },
      "Receipt": {
        "additionalProperties": false,
        "description": "Immutable operation receipt. Current state is supplied separately on replay.",
        "properties": {
          "operation_id": {
            "format": "uuid",
            "type": "string"
          },
          "request_digest": {
            "$ref": "#/$defs/Digest"
          },
          "resulting_owner": {
            "$ref": "#/$defs/Owner"
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "operation_id",
          "request_digest",
          "resulting_owner"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "accepted_through": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "admitted_node_boot_id": {
        "format": "uuid",
        "type": "string"
      },
      "current_owner": {
        "$ref": "#/$defs/Owner"
      },
      "receipt": {
        "$ref": "#/$defs/Receipt"
      }
    },
    "required": [
      "receipt",
      "current_owner",
      "accepted_through",
      "admitted_node_boot_id"
    ],
    "title": "Reply",
    "type": "object"
  },
  "request": {
    "$defs": {
      "Digest": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "Marker": {
        "additionalProperties": false,
        "description": "Written durably into the new store before activation. Initial boot never changes.",
        "properties": {
          "initial_boot_id": {
            "format": "uuid",
            "type": "string"
          },
          "node_id": {
            "format": "uuid",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "type": "string"
          },
          "prepare_digest": {
            "$ref": "#/$defs/Digest"
          },
          "prepare_operation_id": {
            "format": "uuid",
            "type": "string"
          },
          "store_id": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "node_id",
          "store_id",
          "owner_id",
          "initial_boot_id",
          "prepare_operation_id",
          "prepare_digest"
        ],
        "type": "object"
      },
      "Operation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "boot_id": {
                "format": "uuid",
                "type": "string"
              },
              "kind": {
                "const": "prepare",
                "type": "string"
              },
              "store_id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "boot_id",
              "store_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "activate",
                "type": "string"
              },
              "marker": {
                "$ref": "#/$defs/Marker"
              }
            },
            "required": [
              "kind",
              "marker"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "expected_boot_id": {
                "format": "uuid",
                "type": "string"
              },
              "expected_revision": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "const": "advance_boot",
                "type": "string"
              },
              "marker": {
                "$ref": "#/$defs/Marker"
              },
              "new_boot_id": {
                "format": "uuid",
                "type": "string"
              },
              "next_sequence": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "marker",
              "expected_boot_id",
              "expected_revision",
              "new_boot_id",
              "next_sequence"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "node_id": {
        "format": "uuid",
        "type": "string"
      },
      "operation": {
        "$ref": "#/$defs/Operation"
      },
      "operation_id": {
        "format": "uuid",
        "type": "string"
      },
      "version": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "version",
      "operation_id",
      "node_id",
      "operation"
    ],
    "title": "Request",
    "type": "object"
  },
  "status": {
    "$defs": {
      "Digest": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "Marker": {
        "additionalProperties": false,
        "description": "Written durably into the new store before activation. Initial boot never changes.",
        "properties": {
          "initial_boot_id": {
            "format": "uuid",
            "type": "string"
          },
          "node_id": {
            "format": "uuid",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "type": "string"
          },
          "prepare_digest": {
            "$ref": "#/$defs/Digest"
          },
          "prepare_operation_id": {
            "format": "uuid",
            "type": "string"
          },
          "store_id": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "node_id",
          "store_id",
          "owner_id",
          "initial_boot_id",
          "prepare_operation_id",
          "prepare_digest"
        ],
        "type": "object"
      },
      "Owner": {
        "additionalProperties": false,
        "properties": {
          "boot_transitions": {
            "description": "Counts every boot advance. A node may restart without limit.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "current_boot_id": {
            "format": "uuid",
            "type": "string"
          },
          "marker": {
            "$ref": "#/$defs/Marker"
          },
          "phase": {
            "$ref": "#/$defs/Phase"
          },
          "revision": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "marker",
          "phase",
          "current_boot_id",
          "revision",
          "boot_transitions"
        ],
        "type": "object"
      },
      "Phase": {
        "enum": [
          "prepared",
          "active"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "A read-only status response is deliberately a different type from Reply.\nIt can authorize resuming an existing matching store through an owner adapter;\nit cannot be used with may_create or substituted for a preparation receipt.",
    "properties": {
      "accepted_through": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "admitted_node_boot_id": {
        "format": "uuid",
        "type": "string"
      },
      "node_id": {
        "format": "uuid",
        "type": "string"
      },
      "owner": {
        "anyOf": [
          {
            "$ref": "#/$defs/Owner"
          },
          {
            "type": "null"
          }
        ]
      },
      "version": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "version",
      "node_id",
      "admitted_node_boot_id",
      "accepted_through"
    ],
    "title": "Status",
    "type": "object"
  }
}
