{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MachineReport",
  "description": "One machine load report. Load and memory are the machine's own (the\nWindows host's when `source` is `windows_host`); `cpu_busy_bps` is 0-10000.",
  "type": "object",
  "properties": {
    "cpu_busy_bps": {
      "type": "integer",
      "format": "uint16",
      "maximum": 10000,
      "minimum": 0
    },
    "disk_free_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "disk_total_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "host_probe": {
      "$ref": "#/$defs/HostProbe"
    },
    "logical_cpus": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "machine": {
      "$ref": "#/$defs/MachineIdentity"
    },
    "memory_total_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "memory_used_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "observed_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "sandbox_admission": {
      "description": "Present while the machine cannot admit a sandbox and rechecks automatically.",
      "anyOf": [
        {
          "$ref": "#/$defs/AdmissionDeferral"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/LoadSource"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "machine",
    "observed_at_ms",
    "source",
    "host_probe",
    "logical_cpus",
    "memory_total_bytes",
    "memory_used_bytes",
    "cpu_busy_bps"
  ],
  "$defs": {
    "AdmissionDeferral": {
      "description": "Why a machine defers sandbox admission (`sandbox_disk_headroom_unavailable`, ...), since\nwhen on the worker's clock, and for a disk shortfall the bytes available and required.",
      "type": "object",
      "properties": {
        "available_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "code": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$"
        },
        "required_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "since_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "since_ms"
      ]
    },
    "HostProbe": {
      "type": "string",
      "enum": [
        "not_applicable",
        "fresh",
        "stale",
        "missing"
      ]
    },
    "LoadSource": {
      "type": "string",
      "enum": [
        "linux",
        "windows_host"
      ]
    },
    "MachineIdentity": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MachineKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    }
  }
}
